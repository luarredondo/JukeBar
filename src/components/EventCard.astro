---
import photos from "../data/photos.json";

interface Props {
  slug: string;
  title: string;
  date: string;
  album: string;
}

const { slug, title, date, album } = Astro.props;

const albumPhotos = (photos as Record<string, { thumb: string; width: number; height: number }[]>)[album] ?? [];
const cover = albumPhotos[0];

const dateObj = new Date(date);
const day = dateObj.getDate();
const month = dateObj.toLocaleDateString("fr-FR", { month: "short" }).replace(".", "");

const formattedDate = dateObj.toLocaleDateString("fr-FR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<a class="event-card" href={`/${slug}`}>
  <div class="event-card__frame">
    {cover && (
      <img
        class="event-card__image"
        src={cover.thumb}
        alt=""
        width={cover.width}
        height={cover.height}
        loading="lazy"
      />
    )}
    <span class="event-card__badge" aria-hidden="true">
      <strong>{day}</strong>
      <span>{month}</span>
    </span>
  </div>
  <p class="event-card__title">{title}</p>
  <p class="event-card__date">{formattedDate}</p>
</a>
