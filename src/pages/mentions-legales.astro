---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Mentions légales – Le JukeBar"
  description="Mentions légales du site Le JukeBar."
>
  <Header />
  <main id="main">
    <h1>Mentions légales</h1>

    <section>
      <h2>Éditeur du site</h2>
      <p>
        Le JukeBar — 258 rue de Bourgogne, Orléans.
        <br />
        <em>[À compléter : forme juridique, SIRET, nom du responsable de publication, contact]</em>
      </p>
    </section>

    <section>
      <h2>Hébergement</h2>
      <p>
        <em>[À compléter : nom et adresse de l'hébergeur une fois le site déployé]</em>
      </p>
    </section>

    <section>
      <h2>Droit à l'image</h2>
      <p>
        Les photos publiées sur ce site sont prises lors des soirées du JukeBar et peuvent
        représenter des personnes identifiables. Si vous apparaissez sur une photo et
        souhaitez en demander le retrait, contactez-nous via{" "}
        <a href="https://www.instagram.com/lejukebar/">Instagram</a>.
      </p>
    </section>
  </main>
  <Footer />
</Layout>
